rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to identify authorized administrators
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'RybFq34QonRHbx3m1KitV1Wcft83' ||
        request.auth.token.email == 'minominapro@gmail.com'
      );
    }

    // User profiles and history subcollection
    match /users/{userId} {
      // Users can read/write their own account; Admins can read/write all accounts
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /history/{docId} {
        // Users can read/write their own history; Admins can read/write all histories
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // Directory mapping employee number -> registered email / UID
    match /employee_directory/{empNo} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

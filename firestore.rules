rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to identify authorized administrators
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'RybFq34QonRHbx3m1KitV1Wcft83' ||
        request.auth.token.email == 'minominapro@gmail.com'
      );
    }

    // User profiles and history/settings subcollections
    match /users/{userId} {
      // Authenticated users can read (for Google Sign-In self-service lookup/merge) and delete (to purge donor account on merge);
      // Only the document owner or an Admin can create or update user documents
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /history/{docId} {
        // Authenticated users can read/delete (for self-service account merge); only owner or Admin can create/update
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /settings/{docId} {
        // Authenticated users can read/delete (for self-service account merge); only owner or Admin can create/update
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // Directory mapping employee number -> registered email / UID
    match /employee_directory/{empNo} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Unit Managers directory (for employee/manager discovery)
    match /unit_managers/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Shared shifts with Unit Managers
    match /unit_shares/{managerUid} {
      allow read, write: if request.auth != null;

      match /members/{memberUid} {
        // Member can read/write their own document; Manager can read documents shared with them; Admin full access
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == memberUid || isAdmin());
      }
    }
  }
}
